# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# Base URL of the backend API (leave blank to auto-detect the Expo host on LAN).
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000

# Show the password-reset code in the app during development only.
DEV_SHOW_RESET_CODE=false

# SMTP settings used by the backend to send forgot-password codes.
# Gmail example (use an app password, not your normal password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
