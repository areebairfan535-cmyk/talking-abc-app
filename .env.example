# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# ---------------------------------------------------------------------------
# Frontend (Expo)
# ---------------------------------------------------------------------------

# Base URL of the backend API (leave blank to auto-detect the Expo host on LAN).
#   Web / iOS simulator : http://127.0.0.1:5000
#   Android emulator    : http://10.0.2.2:5000
#   Physical phone      : http://<YOUR_LAN_IP>:5000
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000

# Show the password-reset code in the app during development only.
DEV_SHOW_RESET_CODE=false

# ---------------------------------------------------------------------------
# Backend database (MySQL / MariaDB)
# The database and its tables are created automatically on the first request.
# XAMPP defaults are shown below.
# ---------------------------------------------------------------------------

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=talking_abc

# ---------------------------------------------------------------------------
# SMTP — used by the backend to email forgot-password codes.
# Leave blank to skip email delivery; codes are then written to a local log.
# Gmail example (use an App Password, not your normal account password):
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
